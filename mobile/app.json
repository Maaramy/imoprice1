{
  "expo": {
    "name": "imoprice AI",
    "slug": "imoprice-ai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "imopriceai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e40af"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imopriceai.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "L'application utilise vos photos pour analyser l'état et les équipements de votre bien immobilier.",
        "NSCameraUsageDescription": "L'application utilise la caméra pour photographier votre bien immobilier.",
        "NSLocationWhenInUseUsageDescription": "L'application utilise votre position pour pré-remplir la localisation de votre bien."
      }
    },
    "android": {
      "package": "com.imopriceai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e40af"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "edgeToEdgeEnabled": true
    },
    "androidStatusBar": {
      "backgroundColor": "#1e40af",
      "barStyle": "light-content"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application accède à vos photos pour analyser votre bien immobilier.",
          "cameraPermission": "L'application utilise la caméra pour photographier votre bien immobilier."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "L'application utilise votre position pour pré-remplir la localisation de votre bien."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1e40af"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
